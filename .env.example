# Datenbank (PostgreSQL/PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ghcn?schema=public

# Web -> API (wird im Frontend genutzt)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API -> CORS (welche Origin darf die API ansprechen)
WEB_ORIGIN=http://localhost:3000

# API Cache (LRU in-memory)
# Default-Werte sind 10 Minuten TTL und 500 Einträge.
CACHE_TTL_MINUTES=10
CACHE_MAX_ENTRIES=500